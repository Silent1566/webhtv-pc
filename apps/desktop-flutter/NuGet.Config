<?xml version="1.0" encoding="utf-8"?>
<!-- webview_windows restores Microsoft.Windows.ImplementationLibrary and
     Microsoft.Web.WebView2 with nuget install on every build
     (plugins/webview_windows PRE_BUILD). Resolve them from the repository cache
     only: a slow api.nuget.org otherwise parks the build with no output. The
     feed is populated by scripts/prepare_windows_native_deps.ps1. -->
<configuration>
  <packageSources>
    <clear />
    <add key="webhtv-win-deps" value="..\..\.local\win-deps\nuget-local" />
  </packageSources>
</configuration>
