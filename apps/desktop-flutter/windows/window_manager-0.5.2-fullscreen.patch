+void WindowManager::UpdateFullscreenStacking(bool active, HWND next_window) {
+  if (!g_is_window_fullscreen)
+    return;
+  const HWND hwnd = GetMainWindow();
+  HWND after = HWND_TOPMOST;
+  if (!fullscreen_topmost_preference_ && !active) {
+    after = HWND_NOTOPMOST;
+    const HWND foreground = next_window ? next_window : ::GetForegroundWindow();
+    const HWND target = foreground ? ::GetAncestor(foreground, GA_ROOTOWNER) : nullptr;
+    // A normal foreground target must stay above the demoted fullscreen window,
+    // including when its old WA_INACTIVE arrives after the target activates.
+    if (target && target != hwnd && ::IsWindowVisible(target) &&
+        !(::GetWindowLongPtr(target, GWL_EXSTYLE) & WS_EX_TOPMOST))
+      after = target;
+  }
+  ::SetWindowPos(hwnd, after, 0, 0, 0, 0,
+      SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
