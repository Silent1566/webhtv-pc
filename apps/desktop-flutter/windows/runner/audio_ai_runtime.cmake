# Official LiteRT wheel contains the classic TfLite C API exports on Windows.
set(AUDIO_AI_CACHE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../../.local/audio_ai")
set(AUDIO_AI_LITERT_DLL "" CACHE FILEPATH "Offline import of the pinned official LiteRT DLL")
if(NOT AUDIO_AI_LITERT_DLL)
  file(MAKE_DIRECTORY "${AUDIO_AI_CACHE_DIR}")
  set(AUDIO_AI_WHEEL "${AUDIO_AI_CACHE_DIR}/litert.whl")
  set(AUDIO_AI_WHEEL_SHA "b33b039667da6c57815f88d4709c1b31890375fa2cd35f165a3bf9dfd36f23a3")
  if(EXISTS "${AUDIO_AI_WHEEL}")
    file(SHA256 "${AUDIO_AI_WHEEL}" AUDIO_AI_EXISTING_SHA)
    if(NOT AUDIO_AI_EXISTING_SHA STREQUAL AUDIO_AI_WHEEL_SHA)
      message(FATAL_ERROR "Official LiteRT wheel SHA256 mismatch; replace the corrupted cache")
    endif()
  else()
    file(DOWNLOAD
      "https://files.pythonhosted.org/packages/3e/f6/529d465a222282252226d272325d85bcbcf33e618eb3fc241d18f1a645a5/ai_edge_litert-2.3.0-cp312-cp312-win_amd64.whl"
      "${AUDIO_AI_WHEEL}"
      EXPECTED_HASH "SHA256=${AUDIO_AI_WHEEL_SHA}" TIMEOUT 180 TLS_VERIFY ON)
  endif()
  file(MAKE_DIRECTORY "${AUDIO_AI_CACHE_DIR}/litert")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${AUDIO_AI_WHEEL}"
    WORKING_DIRECTORY "${AUDIO_AI_CACHE_DIR}/litert" RESULT_VARIABLE AUDIO_AI_EXTRACT_RESULT)
  if(NOT AUDIO_AI_EXTRACT_RESULT EQUAL 0)
    message(FATAL_ERROR "Failed to extract reviewed official LiteRT wheel")
  endif()
  set(AUDIO_AI_LITERT_DLL "${AUDIO_AI_CACHE_DIR}/litert/ai_edge_litert/libLiteRt.dll")
endif()
file(SHA256 "${AUDIO_AI_LITERT_DLL}" AUDIO_AI_DLL_SHA)
if(NOT AUDIO_AI_DLL_SHA STREQUAL "fd1ee59560a7aa13d44614bd4344c9a75070c18c9faf29792b1841f22dae6add")
  message(FATAL_ERROR "Pinned official LiteRT Windows DLL SHA256 mismatch")
endif()
install(FILES "${AUDIO_AI_LITERT_DLL}" DESTINATION "${INSTALL_BUNDLE_LIB_DIR}" COMPONENT Runtime)
set(AUDIO_AI_LICENSE "${AUDIO_AI_CACHE_DIR}/litert/ai_edge_litert-2.3.0.dist-info/licenses/LICENSE")
if(EXISTS "${AUDIO_AI_LICENSE}")
  install(FILES "${AUDIO_AI_LICENSE}" DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/audio_ai" RENAME "LiteRT-LICENSE.txt" COMPONENT Runtime)
endif()
