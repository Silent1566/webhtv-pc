{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webhtv.local/schema/spider-message.schema.json",
  "title": "WebHTV Spider IPC Message",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "#/$defs/cancel" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "deadlineMs": { "type": "integer", "minimum": 1 }
      },
      "required": ["jsonrpc", "id", "method", "params", "deadlineMs"],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string" },
        "result": {}
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string" },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "$/cancel" },
        "params": {
          "type": "object",
          "properties": { "id": { "type": "string" } },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    }
  }
}
